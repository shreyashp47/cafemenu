# ---------------------------------------------------------------------------
# The app runs with ZERO configuration, and a release build has none.
#
# One build serves every cafe. On Firebase Hosting the app reads its project's
# web config from /__/firebase/init.json when the page loads, and the cafe's
# name, tables and the rest from site.json and Firestore config/site (see
# "Point the app at it" in README.md). With neither, as with `npm run dev`, it
# runs in "demo mode" against a localStorage-backed store in your own browser,
# which is what you want for development.
#
# Copy this file to .env.local only to point a local `npm run dev` at a real
# Firebase project. Every value here is NEXT_PUBLIC_, so it is baked into the
# JavaScript at build time and visible to anyone who opens the site. None of
# them is a secret, including the Firebase API key: firestore.rules protects
# the data. Never build a release with them set: the build would then talk to
# that one project wherever it is deployed.
# ---------------------------------------------------------------------------

# --- Firebase (optional, local development only) ------------------------------
# Firebase console > Project settings > General > Your apps > SDK setup.
# All six must be set; if any is empty they are ignored. When all six are set
# they win over /__/firebase/init.json.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Demo mode only: the staff PIN, 4 to 6 digits. Defaults to 1122 (also used if
# the value is not 4-6 digits). Ignored once Firebase is configured, where staff
# sign in with email and password.
NEXT_PUBLIC_DEMO_STAFF_PIN=1122

# The cafe's name, default tables and the address printed on QR cards used to
# be NEXT_PUBLIC_CAFE_NAME, NEXT_PUBLIC_TABLES and NEXT_PUBLIC_BASE_URL. They
# are the cafe's settings now (`name`, `tables`, `baseUrl`), read at runtime, so
# setting them here does nothing.
