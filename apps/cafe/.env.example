# ---------------------------------------------------------------------------
# The app runs with ZERO configuration.
#
# Copy this file to .env.local only when you need it. With no .env.local the
# app starts in "demo mode": everything works against a localStorage-backed
# store in your own browser, which is what you want for development.
# Fill in the Firebase block below to switch to a real Firestore database.
#
# Every value here is NEXT_PUBLIC_, so it is baked into the JavaScript at
# `npm run build` and visible to anyone who opens the site. None of them is a
# secret, including the Firebase API key: firestore.rules protects the data.
# Change a value, rebuild, redeploy.
#
# The automatic deploy (.github/workflows/deploy.yml) does not read this file.
# It builds from GitHub repository variables with these same names
# (`gh variable set -f .env.local`), and refuses to build if the Firebase
# values or NEXT_PUBLIC_BASE_URL are missing.
# ---------------------------------------------------------------------------

# --- Firebase (optional) -----------------------------------------------------
# Firebase console > Project settings > General > Your apps > SDK setup.
# All six must be set; if any is empty the app stays in demo mode.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Cafe identity (optional) ------------------------------------------------
# Shown in the customer-facing header and on printed QR table cards.
# Defaults to "Mochi & Beans" when unset.
NEXT_PUBLIC_CAFE_NAME="Mochi & Beans"

# Demo mode only: the staff PIN, 4 to 6 digits. Defaults to 1122 (also used if
# the value is not 4-6 digits). Ignored once Firebase is configured, where staff
# sign in with email and password.
NEXT_PUBLIC_DEMO_STAFF_PIN=1122

# Only the DEFAULT table list, e.g. 1,2,3,4,5,6 (the default when unset). Once
# the owner saves a list on /admin/qr it is stored in Firestore at
# config/tables and this is ignored. Numbers above 50 are dropped: the order
# rules refuse any table outside 1-50.
NEXT_PUBLIC_TABLES=1,2,3,4,5,6

# Absolute base URL baked into printed QR codes, e.g. https://yourcafe.web.app
# (just the origin, no path). When empty, /admin/qr uses whatever address it was
# opened on, so cards printed from localhost would point at localhost. For TOE
# Cafe this is https://toe-cafe.web.app, not the old toi-cafe.web.app, which
# only redirects. The automatic deploy refuses to build without it.
NEXT_PUBLIC_BASE_URL=
