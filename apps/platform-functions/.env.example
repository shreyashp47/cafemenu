# Settings for deploying the platform's functions, read by `firebase deploy`
# and by the functions themselves. Copy to `.env.<platform-project-id>` (git
# ignores it) and fill in what you use. None of it is secret: the mail
# provider's API key is a Secret Manager secret, set with
#   npx firebase-tools functions:secrets:set RESEND_API_KEY --project <id>
# See README.md, "Emails".

# "log" (the default) writes each email to the function's log and sends it to
# nobody. "resend" sends them through Resend.
MAIL_PROVIDER=log

# With resend: the sender, on a domain you have verified with Resend.
# MAIL_FROM=CafeMenu <hello@your-domain.example>

# The console's address, for the "open Updates" links in emails.
# CONSOLE_URL=https://console.your-domain.example

# The address of the deployed `unsubscribe` function, which `firebase deploy`
# prints. Without it the emails an owner may switch off are not sent.
# UNSUBSCRIBE_URL=https://unsubscribe-xxxxxxxxxx-uc.a.run.app
