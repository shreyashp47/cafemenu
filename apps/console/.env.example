# ---------------------------------------------------------------------------
# The console runs with ZERO configuration.
#
# With no .env.local it starts in "demo mode": accounts and cafes are kept in
# your own browser's localStorage, nothing is sent anywhere, and no email goes
# out. That is what you want for working on the pages.
#
# Copy this file to .env.local only to talk to Firebase: the local emulators
# (no account needed) or the real platform project.
#
# Every value here is NEXT_PUBLIC_, so it is baked into the JavaScript at
# `npm run build` and visible to anyone who opens the site. None of them is a
# secret, including the Firebase API key: firestore.rules protects the data.
# ---------------------------------------------------------------------------

# --- Emulators (optional) ----------------------------------------------------
# Set to 1 to use the Auth and Firestore emulators of `npm run emulators`
# (project demo-cafemenu) instead of demo mode. Needs Java 21+. The Firebase
# block below is ignored while this is on.
NEXT_PUBLIC_FIREBASE_EMULATORS=

# --- The platform's Firebase project (optional) --------------------------------
# Firebase console > Project settings > General > Your apps > SDK setup.
# All six must be set; if any is empty the console stays in demo mode.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Sign-up (optional) ----------------------------------------------------------
# Set to 1 to open the sign-up form against the platform project above. Demo
# mode and the emulators always show it; the real platform shows "coming
# soon" until this is set, so the landing page can go live before sign-up.
NEXT_PUBLIC_SIGNUP_OPEN=

# --- Onboarding (optional) -------------------------------------------------------
# The platform's deploy service account, which each owner adds to their own
# project at the "Give CafeMenu access" step, e.g.
# deploy@<platform-project>.iam.gserviceaccount.com. Not a secret: it is an
# address, and only its key (never in this repository) can act as it. Demo
# mode and the emulators show a demo- stand-in when it is empty.
NEXT_PUBLIC_DEPLOY_SERVICE_ACCOUNT=

# --- The backend (optional) -------------------------------------------------------
# How Check connection, Upgrade, Roll back and Save branding reach the
# platform's backend (apps/platform-functions). Demo mode ignores it.
#
#   requests   write a request document that the backend's GitHub Actions job
#              (.github/workflows/backend.yml) picks up within a few minutes,
#              and follow it live. Free: the platform stays on Spark. Against
#              the emulators, run the worker beside them:
#              `npm run worker -w @cafemenu/platform-functions -- --loop 10`
#              (see that app's README).
#   functions  call the backend's Cloud Functions, which answer at once. Needs
#              the platform on Blaze. Against the emulators, run that app's
#              `npm run emulators` instead of this one's (same ports).
#
# Empty: the emulators answer with stand-ins, and the real platform says the
# backend isn't switched on yet.
NEXT_PUBLIC_BACKEND=
# The functions' region, with NEXT_PUBLIC_BACKEND=functions; us-central1 when
# empty. (NEXT_PUBLIC_BACKEND_FUNCTIONS=1 is the old way to say "functions",
# still understood.)
NEXT_PUBLIC_FUNCTIONS_REGION=
