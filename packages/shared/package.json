{
  "name": "@cafemenu/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Types and pure helpers shared by the CafeMenu apps and tools: cafe settings, plans and their features.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./icons": "./src/icons/index.ts",
    "./support-window": {
      "types": "./src/support-window.d.mts",
      "default": "./src/support-window.mjs"
    },
    "./requests": {
      "types": "./src/requests.d.mts",
      "default": "./src/requests.mjs"
    }
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format:check": "prettier --check .",
    "verify": "npm run typecheck && npm run test && npm run format:check"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
